# ===========================================
# Supabase PostgreSQL Connection
# ===========================================
# Lấy từ: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=
# Giới hạn connection pool cho mỗi service khi dùng session mode / pooler
DB_POOL_MAX=3
# Hoặc dùng từng biến riêng lẻ:
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

Database_Password=
# ===========================================
# App Config
# ===========================================
NODE_ENV=development

# ===========================================
# Frontend URLs
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Bỏ qua kiểm tra quyền trang ở web-client (proxy.ts). Mặc định false — chỉ bật khi cần dev nhanh.
AUTH_DEV_BYPASS=false

# ===========================================
# Groq API Key — dùng chung cho cả FE và BE
# FE: Voice Search (Whisper speech-to-text)
# BE: Các model AI phù hợp cho từng chức năng backend
# Lấy từ: https://console.groq.com/keys
# ===========================================
NEXT_PUBLIC_GROQ_API_KEY=
GROQ_API_KEY=
# Model Groq cho từng chức năng (spec 018). Groq gỡ model → chỉ cần đổi ở đây.
# Kiểm tra model khả dụng: GET https://api.groq.com/openai/v1/models
GROQ_QUERY_MODEL=openai/gpt-oss-20b
GROQ_DESCRIPTION_MODEL=openai/gpt-oss-20b
GROQ_REVIEW_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ===========================================
# Embedding (vector ngữ nghĩa) — chạy CỤC BỘ bằng @huggingface/transformers,
# model all-MiniLM-L6-v2 tự tải từ HuggingFace Hub lần đầu (~23 MB). KHÔNG cần token.
# HUGGINGFACE_API_TOKEN không còn được dùng (spec 018).
# ===========================================

# ===========================================
# Cloudinary — Media Storage (images & videos)
# Lấy từ: https://cloudinary.com/console → Dashboard
# ===========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================================
# RabbitMQ - local Docker by default (inter-service messaging)
# Start local RabbitMQ: npm run rabbitmq:up
# AMQP: amqp://localhost:5672
# Management UI: http://localhost:15672 (guest / guest)
# ===========================================
RMQ_URL=amqp://localhost:5672
RMQ_PROVIDER=local
# Optional CloudAMQP. Only used when RMQ_PROVIDER=cloud.
# CLOUDAMQP_URL=amqps://...

# ===========================================
# Redis - local Docker by default (search cache + API rate limit)
# Start local Redis: npm run redis:up
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_CONNECT_TIMEOUT_MS=1000
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_SEARCH_LIMIT=60
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_REVIEW_LIMIT=30
RATE_LIMIT_REVIEW_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_LIMIT=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=600

# ===========================================
# JWT Config
# ===========================================
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# ===========================================
# SMTP — Email (OTP đăng ký, liên kết đặt lại mật khẩu)
# Dev (khuyến nghị): Mailpit chạy bằng `npm run infra:up` — xem thư tại http://localhost:8026
#   SMTP_HOST=localhost  SMTP_PORT=1026  SMTP_USER / SMTP_PASS để trống (không xác thực)
# Gửi thật qua Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 + App Password
#   https://myaccount.google.com/apppasswords
# ===========================================
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MyNook <noreply@mynook.com>"
# Địa chỉ web-client dùng cho liên kết trong email (mặc định lấy NEXT_PUBLIC_APP_URL)
APP_URL=http://localhost:3000

# ===========================================
# Service URLs nội bộ (mặc định localhost — chỉ cần khi deploy tách máy)
# ===========================================
# AUTH_SERVICE_URL=http://localhost:3002
# VENUE_SERVICE_URL=http://localhost:3003
# INTERACTION_SERVICE_URL=http://localhost:3004
# SEARCH_AI_SERVICE_URL=http://localhost:3005
# Gateway cho phép các origin này gọi API (phân cách bằng dấu phẩy)
CORS_ORIGIN=http://localhost:3000
# Tile bản đồ Leaflet (mặc định OpenStreetMap)
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# ===========================================
# Test E2E (Playwright) — mặc định dùng DATABASE_URL; chỉ đặt khi tách DB test
# ===========================================
# E2E_DATABASE_URL=
