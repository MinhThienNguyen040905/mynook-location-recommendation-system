# ===========================================
# Supabase PostgreSQL Connection
# ===========================================
# Lấy từ: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=
# Giới hạn connection pool cho mỗi service khi dùng session mode / pooler
DB_POOL_MAX=3
# Hoặc dùng từng biến riêng lẻ:
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

Database_Password=
# ===========================================
# App Config
# ===========================================
NODE_ENV=development

# ===========================================
# Frontend URLs
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ===========================================
# Groq API Key — dùng chung cho cả FE và BE
# FE: Voice Search (Whisper speech-to-text)
# BE: Các model AI phù hợp cho từng chức năng backend
# Lấy từ: https://console.groq.com/keys
# ===========================================
NEXT_PUBLIC_GROQ_API_KEY=
GROQ_API_KEY=

# ===========================================
# Cloudinary — Media Storage (images & videos)
# Lấy từ: https://cloudinary.com/console → Dashboard
# ===========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================================
# RabbitMQ - local Docker by default (inter-service messaging)
# Start local RabbitMQ: npm run rabbitmq:up
# AMQP: amqp://localhost:5672
# Management UI: http://localhost:15672 (guest / guest)
# ===========================================
RMQ_URL=amqp://localhost:5672
RMQ_PROVIDER=local
# Optional CloudAMQP. Only used when RMQ_PROVIDER=cloud.
# CLOUDAMQP_URL=amqps://...

# ===========================================
# Redis - local Docker by default (search cache + API rate limit)
# Start local Redis: npm run redis:up
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_CONNECT_TIMEOUT_MS=1000
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_SEARCH_LIMIT=60
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_REVIEW_LIMIT=30
RATE_LIMIT_REVIEW_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_LIMIT=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=600

# ===========================================
# JWT Config
# ===========================================
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# ===========================================
# SMTP — Email (OTP xác thực đăng ký)
# Dùng App Password nếu Gmail: https://myaccount.google.com/apppasswords
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MyNook <noreply@mynook.com>"
